{
  "name": "jexactyl-web-ide",
  "displayName": "Jexactyl Web IDE Integration",
  "description": "Secure terminal, server console, and collaborative editing for Jexactyl Web IDE sessions.",
  "version": "1.3.3",
  "publisher": "jexactyl",
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "browser": "./dist/extension.js",
  "activationEvents": ["*", "onStartupFinished"],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --format=cjs --platform=browser --external:vscode --outfile=dist/extension.js --minify --sourcemap",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "y-websocket": "3.0.0",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@types/vscode": "1.105.0",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "jexactyl.webIde.openTerminal",
        "title": "Jexactyl: Open Server Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "jexactyl.webIde.openConsole",
        "title": "Jexactyl: Open Server Console",
        "icon": "$(terminal)"
      },
      {
        "command": "jexactyl.webIde.manageByok",
        "title": "Jexactyl: Configure BYOK Agent"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "jexactyl-byok",
        "displayName": "Jexactyl BYOK",
        "managementCommand": "jexactyl.webIde.manageByok"
      }
    ],
    "configuration": {
      "title": "Jexactyl Web IDE",
      "properties": {
        "jexactyl.webIde.endpoint": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Session-scoped Wings WebSocket endpoint. Managed by Jexactyl."
        },
        "jexactyl.webIde.extensionToken": {
          "type": "string",
          "default": "",
          "scope": "window",
          "secret": true,
          "description": "Ephemeral session credential managed by Wings."
        },
        "jexactyl.webIde.displayName": {
          "type": "string",
          "default": "User",
          "scope": "window"
        },
        "jexactyl.webIde.canUseConsole": {
          "type": "boolean",
          "default": false,
          "scope": "window"
        },
        "jexactyl.webIde.byokProvider": {
          "type": "string",
          "enum": ["openai", "openrouter"],
          "default": "openrouter",
          "scope": "window",
          "description": "BYOK provider. Provider destinations are allowlisted by Wings."
        },
        "jexactyl.webIde.byokModel": {
          "type": "string",
          "default": "openai/gpt-4.1",
          "scope": "window",
          "description": "Provider model identifier for the encrypted server/user BYOK agent."
        }
      }
    },
    "terminal": {
      "profiles": [
        {
          "id": "jexactyl.serverTerminal",
          "title": "Jexactyl Server",
          "icon": "terminal"
        }
      ]
    }
  }
}
